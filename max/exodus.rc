// Exodus for 3ds Max: rollouts and strings.
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_UNSUBDIVIDE DIALOGEX 0, 0, 108, 84
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Levels:", -1, 6, 8, 30, 8
    CONTROL         "", IDC_LEVELS_EDIT, "CustEdit", WS_TABSTOP, 40, 6, 26, 10
    CONTROL         "", IDC_LEVELS_SPIN, "SpinnerControl", 0x0, 67, 6, 7, 10
    CONTROL         "Symmetry", IDC_SYMMETRY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 22, 70, 10
    CONTROL         "Quad dominant", IDC_QUAD_DOMINANT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 35, 90, 10
    LTEXT           "", IDC_STATUS, 6, 52, 96, 28
END

IDD_DECIMATE DIALOGEX 0, 0, 108, 120
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Keep %:", -1, 6, 8, 30, 8
    CONTROL         "", IDC_PERCENT_EDIT, "CustEdit", WS_TABSTOP, 40, 6, 34, 10
    CONTROL         "", IDC_PERCENT_SPIN, "SpinnerControl", 0x0, 75, 6, 7, 10
    CONTROL         "Symmetry", IDC_SYMMETRY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 22, 70, 10
    CONTROL         "Lock borders", IDC_LOCK_BORDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 35, 70, 10
    CONTROL         "Lock smoothing groups", IDC_LOCK_SMOOTHING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 48, 96, 10
    LTEXT           "", IDC_STATUS, 6, 64, 96, 52
END

IDD_MATERIAL_COMBINE DIALOGEX 0, 0, 108, 526
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Source UV channel:", -1, 4, 6, 64, 8
    CONTROL         "", IDC_SOURCE_EDIT, "CustEdit", WS_TABSTOP, 70, 4, 24, 10
    CONTROL         "", IDC_SOURCE_SPIN, "SpinnerControl", 0x0, 95, 4, 7, 10
    LTEXT           "Target UV channel:", -1, 4, 19, 64, 8
    CONTROL         "", IDC_TARGET_EDIT, "CustEdit", WS_TABSTOP, 70, 17, 24, 10
    CONTROL         "", IDC_TARGET_SPIN, "SpinnerControl", 0x0, 95, 17, 7, 10
    CONTROL         "Keep target UV layout", IDC_KEEP_LAYOUT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 30, 100, 10
    LTEXT           "Size (0 = fit):", -1, 4, 45, 58, 8
    CONTROL         "", IDC_SIZE_EDIT, "CustEdit", WS_TABSTOP, 64, 43, 30, 10
    CONTROL         "", IDC_SIZE_SPIN, "SpinnerControl", 0x0, 95, 43, 7, 10
    LTEXT           "Max size:", -1, 4, 58, 58, 8
    CONTROL         "", IDC_MAXSIZE_EDIT, "CustEdit", WS_TABSTOP, 64, 56, 30, 10
    CONTROL         "", IDC_MAXSIZE_SPIN, "SpinnerControl", 0x0, 95, 56, 7, 10
    LTEXT           "Padding:", -1, 4, 71, 58, 8
    CONTROL         "", IDC_PADDING_EDIT, "CustEdit", WS_TABSTOP, 70, 69, 24, 10
    CONTROL         "", IDC_PADDING_SPIN, "SpinnerControl", 0x0, 95, 69, 7, 10
    CONTROL         "Rotate islands", IDC_ROTATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 83, 90, 10
    LTEXT           "Channels: name, type", -1, 4, 99, 100, 8
    CONTROL         "", IDC_CHANNEL1 + 0, "CustEdit", WS_TABSTOP, 4, 109, 52, 10
    COMBOBOX        IDC_KIND1 + 0, 58, 108, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CHANNEL1 + 1, "CustEdit", WS_TABSTOP, 4, 122, 52, 10
    COMBOBOX        IDC_KIND1 + 1, 58, 121, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CHANNEL1 + 2, "CustEdit", WS_TABSTOP, 4, 135, 52, 10
    COMBOBOX        IDC_KIND1 + 2, 58, 134, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CHANNEL1 + 3, "CustEdit", WS_TABSTOP, 4, 148, 52, 10
    COMBOBOX        IDC_KIND1 + 3, 58, 147, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CHANNEL1 + 4, "CustEdit", WS_TABSTOP, 4, 161, 52, 10
    COMBOBOX        IDC_KIND1 + 4, 58, 160, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CHANNEL1 + 5, "CustEdit", WS_TABSTOP, 4, 174, 52, 10
    COMBOBOX        IDC_KIND1 + 5, 58, 173, 46, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Auto detect maps", IDC_DETECT, 4, 188, 100, 13
    LTEXT           "Object:", -1, 4, 209, 26, 8
    COMBOBOX        IDC_OBJECT, 32, 207, 72, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "UDIM tiles:", -1, 4, 221, 100, 8
    LISTBOX         IDC_TILES, 4, 231, 100, 50, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "", IDC_TILE_LABEL, 4, 285, 100, 8
    LTEXT           "", IDC_FILE_LABEL1 + 0, 4, 297, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 0, 37, 295, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 0, 95, 295, 9, 11
    LTEXT           "", IDC_FILE_LABEL1 + 1, 4, 310, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 1, 37, 308, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 1, 95, 308, 9, 11
    LTEXT           "", IDC_FILE_LABEL1 + 2, 4, 323, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 2, 37, 321, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 2, 95, 321, 9, 11
    LTEXT           "", IDC_FILE_LABEL1 + 3, 4, 336, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 3, 37, 334, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 3, 95, 334, 9, 11
    LTEXT           "", IDC_FILE_LABEL1 + 4, 4, 349, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 4, 37, 347, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 4, 95, 347, 9, 11
    LTEXT           "", IDC_FILE_LABEL1 + 5, 4, 362, 32, 8
    PUSHBUTTON      "", IDC_FILE1 + 5, 37, 360, 57, 11
    PUSHBUTTON      "x", IDC_CLEAR1 + 5, 95, 360, 9, 11
    LTEXT           "Output folder:", -1, 4, 377, 100, 8
    CONTROL         "", IDC_OUT_DIR, "CustEdit", WS_TABSTOP, 4, 387, 86, 10
    PUSHBUTTON      "...", IDC_OUT_DIR_BROWSE, 92, 386, 12, 11
    LTEXT           "Prefix:", -1, 4, 402, 28, 8
    CONTROL         "", IDC_PREFIX, "CustEdit", WS_TABSTOP, 34, 400, 70, 10
    PUSHBUTTON      "ID map", IDC_ID_MAP, 4, 414, 48, 14
    PUSHBUTTON      "Flat albedo", IDC_ALBEDO, 56, 414, 48, 14
    CONTROL         "ID by connection", IDC_ID_BY_CONNECTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 431, 100, 10
    PUSHBUTTON      "Preview", IDC_PREVIEW, 4, 444, 48, 14
    PUSHBUTTON      "Bake atlas", IDC_BAKE, 56, 444, 48, 14
    LTEXT           "", IDC_STATUS, 4, 462, 100, 60
END

STRINGTABLE
BEGIN
    IDS_CATEGORY "Exodus"
    IDS_UNSUBDIVIDE "Unsubdivide"
    IDS_PARAMETERS "Parameters"
    IDS_LEVELS "Levels"
    IDS_SYMMETRY "Symmetry"
    IDS_DECIMATE "Decimate"
    IDS_PERCENT "Keep %"
    IDS_LOCK_BORDER "Lock borders"
    IDS_MATERIAL_COMBINE "Material Combine"
    IDS_SOURCE_CHANNEL "Source UV channel"
    IDS_TARGET_CHANNEL "Target UV channel"
    IDS_SIZE "Size"
    IDS_MAX_SIZE "Max size"
    IDS_PADDING "Padding"
    IDS_ROTATE "Rotate islands"
    IDS_OUT_DIR "Output folder"
    IDS_PREFIX "Prefix"
    IDS_CHANNEL "Channel"
    IDS_KIND "Type"
    IDS_KIND_COLOR "Color"
    IDS_KIND_NORMAL_GL "Normal GL"
    IDS_KIND_NORMAL_DX "Normal DX"
    IDS_MAP_TILES "Map tiles"
    IDS_MAP_CHANNELS "Map channels"
    IDS_MAP_FILES "Map files"
    IDS_ASSIGN_MAP "Assign map"
    IDS_CHOOSE_OUT_DIR "Atlas output folder"
    IDS_QUAD_DOMINANT "Quad dominant"
    IDS_LOCK_SMOOTHING "Lock smoothing groups"
    IDS_MAP_OBJECTS "Map objects"
    IDS_COLLAPSED_OBJECTS "Collapsed objects"
    IDS_KEEP_LAYOUT "Keep target UV layout"
    IDS_AUTO_DETECT "Auto detect maps"
    IDS_ID_BY_CONNECTION "ID by connection"
END
